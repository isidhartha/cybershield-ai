OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM provider — set to "ollama" to use a free local model (no API key needed)
# Options: openai (default), ollama
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
REDIS_URL=redis://redis:6379
GITLEAKS_PATH=/usr/local/bin/gitleaks
TRUFFLEHOG_PATH=/usr/local/bin/trufflehog
BEARER_PATH=/usr/local/bin/bearer
OSV_API_URL=https://api.osv.dev/v1
MAX_SCAN_SIZE_MB=50
REPORT_OUTPUT_DIR=./reports
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:3000
